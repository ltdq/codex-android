--- a/Lib/ctypes/__init__.py
+++ b/Lib/ctypes/__init__.py
@@ -562,7 +562,14 @@
     pythonapi = PyDLL("python dll", None, _sys.dllhandle)
 elif _sys.platform in ["android", "cygwin"]:
     # These are Unix-like platforms which use a dynamically-linked libpython.
-    pythonapi = PyDLL(_sysconfig.get_config_var("LDLIBRARY"))
+    # Android builds here can be static (no libpython .so in the app's native
+    # library dir), in which case dlopen(NULL) exposes the interpreter's own
+    # exported symbols.
+    _ldlibrary = _sysconfig.get_config_var("LDLIBRARY")
+    if _ldlibrary and not _ldlibrary.endswith(".a"):
+        pythonapi = PyDLL(_ldlibrary)
+    else:
+        pythonapi = PyDLL(None)
 else:
     pythonapi = PyDLL(None)
 
