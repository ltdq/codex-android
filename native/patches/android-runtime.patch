@@ -0,0 +1,56 @@
+//! Explicit shell configuration for Android embedders with a packaged toolchain.
+
+use crate::shell_detect::DetectedShell;
+use crate::shell_detect::ShellType;
+use std::io;
+use std::os::unix::fs::PermissionsExt;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::OnceLock;
+
+static BASH: OnceLock<DetectedShell> = OnceLock::new();
+
+/// Installs the packaged Bash path before any Codex runtime workers are started.
+/// A running process cannot switch toolchains; callers must restart the host.
+pub fn configure(bash_path: PathBuf) -> io::Result<()> {
+    if !bash_path.is_absolute() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "Android Bash path must be absolute",
+        ));
+    }
+    let metadata = std::fs::metadata(&bash_path)?;
+    if !metadata.is_file() || metadata.permissions().mode() & 0o111 == 0 {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "packaged Android Bash is not executable",
+        ));
+    }
+    let shell = DetectedShell {
+        shell_type: ShellType::Bash,
+        shell_path: bash_path,
+    };
+    let configured = BASH.get_or_init(|| shell.clone());
+    if configured != &shell {
+        return Err(io::Error::new(
+            io::ErrorKind::AlreadyExists,
+            "Android toolchain already configured with a different Bash",
+        ));
+    }
+    Ok(())
+}
+
+pub(crate) fn configured_shell() -> DetectedShell {
+    BASH.get()
+        .expect("configure the Android toolchain before starting Codex")
+        .clone()
+}
+
+/// Identifies the local packaged shell, leaving foreign executor shells unchanged.
+pub fn is_configured_shell(path: &Path) -> bool {
+    BASH.get().is_some_and(|shell| shell.shell_path == path)
+}
+
+#[cfg(test)]
+#[path = "android_tests.rs"]
+mod tests;
