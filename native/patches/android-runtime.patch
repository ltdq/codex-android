+use super::*;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn packaged_shell_requires_an_executable_and_cannot_change_after_startup() {
+    let root = tempfile::tempdir().unwrap();
+    let bash = root.path().join("bash");
+    std::fs::write(&bash, b"test executable").unwrap();
+    assert!(configure(bash.clone()).is_err());
+    std::fs::set_permissions(&bash, std::fs::Permissions::from_mode(0o700)).unwrap();
+    configure(bash.clone()).unwrap();
+    configure(bash.clone()).unwrap();
+    assert_eq!(
+        configured_shell(),
+        DetectedShell {
+            shell_type: ShellType::Bash,
+            shell_path: bash.clone()
+        }
+    );
+    assert!(is_configured_shell(&bash));
+    let other = root.path().join("other-bash");
+    std::fs::copy(&bash, &other).unwrap();
+    assert_eq!(
+        configure(other).unwrap_err().kind(),
+        io::ErrorKind::AlreadyExists
+    );
+}
